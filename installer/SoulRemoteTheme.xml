<?xml version="1.0" encoding="utf-8"?>
<!--
    Soul Remote — setup theme.

    Burn's stock themes are a grey Win32 dialog, which is the first thing anyone sees
    of an app whose whole identity is a dark instrument console. This is the same
    palette as Resources/Palette.xaml, laid out the same way as the app itself: a dark
    rail down the left carrying the mark, the content to its right, and nothing on the
    page that is not doing work.

    It is a straight restyle of WiX's own HyperlinkSidebarTheme, so every control name
    wixstdba looks for is still here and still spelled the same. Renaming or removing
    one does not fail the build — it fails at run time, when setup.exe opens to a blank
    window or refuses to open at all.

    Referenced images come from the bundle: logo.png and logoside.png are payloaded by
    LogoFile and LogoSideFile in Bundle.wxs, and are generated by tools/make-brand.ps1.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">

    <!--
        The brand is the rail on the left, and the page beside it is light.

        That split is not a compromise, it is the only readable answer. Half the
        controls on these pages are real Win32 controls that thmutil cannot recolour:
        a checkbox takes the system text colour whatever font it is given, a hyperlink
        takes the system link colour, and a push button is drawn by Windows. Against a
        dark page those come out near-black on near-black. The rail carries the palette;
        the page carries the controls, and every one of them is legible.

        Font 0 also supplies the window ground, so it is the one that decides this.
    -->
    <Font Id="0" Height="-12" Weight="500" Foreground="1B2432" Background="FFFFFF">Segoe UI</Font>
    <!-- Display: the condensed face the app uses for its own headings. -->
    <Font Id="1" Height="-26" Weight="600" Foreground="121826" Background="FFFFFF">Bahnschrift</Font>
    <!-- Lead: the one-line answer to "what is about to happen". -->
    <Font Id="2" Height="-17" Weight="500" Foreground="2A3446" Background="FFFFFF">Segoe UI</Font>
    <!-- Body, dimmed. -->
    <Font Id="3" Height="-12" Weight="500" Foreground="5A6679" Background="FFFFFF">Segoe UI</Font>
    <!-- Reserved for the licence link, which Windows draws in its own colour anyway. -->
    <Font Id="4" Height="-12" Weight="500" Foreground="0E7A6D" Background="FFFFFF">Segoe UI</Font>
    <!-- Fault, for the failure page. Darkened from the palette to carry on white. -->
    <Font Id="5" Height="-12" Weight="500" Foreground="C0263A" Background="FFFFFF">Segoe UI</Font>

    <Window Width="640" Height="460" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)">

        <Page Name="Loading">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="200" Width="-24" Height="30" FontId="2" DisablePrefix="yes"
                   Visible="no" Name="CheckingForUpdatesLabel">#(loc.CheckingForUpdatesLabel)</Label>
        </Page>

        <Page Name="Help">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="34" Width="-24" Height="34" FontId="1" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="252" Y="84" Width="-24" Height="-70" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-24" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Install">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="40" Width="-24" Height="36" FontId="1" DisablePrefix="yes">#(loc.InstallHeader)</Label>
            <Label X="252" Y="90" Width="-24" Height="56" FontId="2" DisablePrefix="yes">
                <Text Condition="WixStdBASuppressOptionsUI">#(loc.InstallMessage)</Text>
                <Text Condition="NOT WixStdBASuppressOptionsUI">#(loc.InstallMessageOptions)</Text>
            </Label>
            <Label X="252" Y="158" Width="-24" Height="116" FontId="3" DisablePrefix="yes">#(loc.InstallDetail)</Label>

            <Hypertext Name="EulaHyperlink" X="252" Y="-116" Width="-24" Height="19" TabStop="yes"
                       FontId="4" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
            <Label Name="InstallVersion" X="252" Y="-90" Width="-24" Height="19" FontId="3"
                   DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
            <Checkbox Name="EulaAcceptCheckbox" X="252" Y="-60" Width="-24" Height="19" TabStop="yes"
                      FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>

            <Button Name="InstallUpdateButton" X="24" Y="-20" Width="180" Height="26" TabStop="yes" FontId="0"
                    EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="OptionsButton" X="-206" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0"
                    VisibleCondition="NOT WixStdBASuppressOptionsUI">
                <Text>#(loc.InstallOptionsButton)</Text>
                <ChangePageAction Page="Options" />
            </Button>
            <Button Name="InstallButton" X="-122" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
            <Button Name="InstallCancelButton" X="-24" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Options">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="40" Width="-24" Height="36" FontId="1" DisablePrefix="yes">#(loc.OptionsHeader)</Label>
            <Label X="252" Y="92" Width="-24" Height="19" FontId="3">#(loc.OptionsLocationLabel)</Label>
            <Editbox Name="InstallFolder" X="252" Y="116" Width="-116" Height="23" TabStop="yes"
                     FontId="0" FileSystemAutoComplete="yes" />
            <Button Name="BrowseButton" X="-24" Y="115" Width="92" Height="25" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsBrowseButton)</Text>
                <BrowseDirectoryAction VariableName="InstallFolder" />
            </Button>
            <Label X="252" Y="150" Width="-24" Height="60" FontId="3" DisablePrefix="yes">#(loc.OptionsDetail)</Label>
            <Button Name="OptionsOkButton" X="-122" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsOkButton)</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button Name="OptionsCancelButton" X="-24" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsCancelButton)</Text>
                <ChangePageAction Page="Install" Cancel="yes" />
            </Button>
        </Page>

        <Page Name="Progress">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="40" Width="-24" Height="36" FontId="1" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label X="252" Y="92" Width="-24" Height="40" FontId="3" DisablePrefix="yes">#(loc.ProgressDetail)</Label>
            <Label X="252" Y="150" Width="70" Height="19" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
            <Label Name="OverallProgressPackageText" X="326" Y="150" Width="-24" Height="19" FontId="3"
                   DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="252" Y="176" Width="-24" Height="16" />
            <Button Name="ProgressCancelButton" X="-24" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>

        <Page Name="Modify">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="40" Width="-24" Height="36" FontId="1" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Label X="252" Y="92" Width="-24" Height="60" FontId="3" DisablePrefix="yes">#(loc.ModifyDetail)</Label>
            <Button Name="ModifyUpdateButton" X="24" Y="-20" Width="180" Height="26" TabStop="yes" FontId="0"
                    EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="RepairButton" X="-206" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0"
                    HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-122" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-24" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Success">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="40" Width="-24" Height="36" FontId="1" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
            </Label>
            <Label X="252" Y="92" Width="-24" Height="80" FontId="3" DisablePrefix="yes">#(loc.SuccessDetail)</Label>
            <Label X="252" Y="-96" Width="-24" Height="36" FontId="3" DisablePrefix="yes"
                   VisibleCondition="WixStdBARestartRequired">
                <Text>#(loc.SuccessRestartText)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text>
            </Label>
            <Button Name="LaunchButton" X="-122" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0"
                    HideWhenDisabled="yes">#(loc.SuccessLaunchButton)</Button>
            <Button Name="SuccessRestartButton" X="-122" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0"
                    HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-24" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Failure">
            <ImageControl X="0" Y="0" Width="220" Height="460" ImageFile="logoside.png" />
            <Label X="252" Y="40" Width="-24" Height="36" FontId="1" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.FailureCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="252" Y="96" Width="-24" Height="68" FontId="3"
                       TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="252" Y="176" Width="-24" Height="96" FontId="5"
                       TabStop="yes" HideWhenDisabled="yes" />
            <Label X="252" Y="-96" Width="-24" Height="60" FontId="3" DisablePrefix="yes"
                   VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-122" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0"
                    HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-24" Y="-20" Width="92" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

    </Window>
</Theme>
