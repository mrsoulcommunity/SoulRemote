<Window x:Class="SoulRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SoulRemote.ViewModels"
        xmlns:views="clr-namespace:SoulRemote.Views"
        xmlns:p="clr-namespace:SoulRemote.Platform"
        Title="Soul Remote" Height="760" Width="1120"
        FlowDirection="{p:FlowDirection}"
        MinHeight="620" MinWidth="960"
        Background="{StaticResource VoidBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Custom chrome: the title bar is part of the console, not an OS strip. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <vm:LinkStateToBrushConverter x:Key="StateBrush" />
        <vm:EqualsConverter x:Key="Equals" />

        <!-- Page routing: each child view model resolves to its view. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
            <views:ConnectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Navigation rail ================= -->
            <Border Grid.Column="0" Background="{StaticResource RailBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Wordmark -->
                    <StackPanel Grid.Row="0" Margin="22,26,22,26">
                        <TextBlock Text="{p:T ui.app.name}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{p:T ui.app.tagline}" Style="{StaticResource DataDim}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource NavItem}" Content="{p:T ui.nav.dashboard}"
                                     GroupName="Nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=dashboard}" />
                        <RadioButton Style="{StaticResource NavItem}" Content="{p:T ui.nav.connect}"
                                     GroupName="Nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="connect"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=connect}" />
                        <RadioButton Style="{StaticResource NavItem}" Content="{p:T ui.nav.settings}"
                                     GroupName="Nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="settings"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=settings}" />
                        <RadioButton Style="{StaticResource NavItem}" Content="{p:T ui.nav.logs}"
                                     GroupName="Nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="logs"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=logs}" />

                        <TextBlock Text="{p:T ui.quick.title}" Style="{StaticResource Eyebrow}" Margin="22,22,22,8" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.quick.lock}" Margin="16,4"
                                Command="{Binding LockCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.quick.sleep}" Margin="16,4"
                                Command="{Binding SleepCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.quick.display}" Margin="16,4"
                                Command="{Binding DisplayOffCommand}" />
                    </StackPanel>

                    <!-- Persistent status: the one thing worth seeing from any page. -->
                    <Border Grid.Row="2" Margin="16,0,16,16" Padding="14,12"
                            Background="{StaticResource DeckBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding StatusState, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MachineName}" Style="{StaticResource DataDim}" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Version}" Style="{StaticResource DataDim}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Hairline of relay colour separating rail from stage. -->
            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right"
                    Background="{StaticResource RailEdgeBrush}" />

            <!-- ================= Stage ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar (drag surface + caption buttons) -->
                <Grid Grid.Row="0" Height="38" Background="{StaticResource VoidBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="{Binding Crumb}" Style="{StaticResource Eyebrow}"
                               VerticalAlignment="Center" Margin="32,0,0,0" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                                Click="Minimize_Click" ToolTip="{p:T ui.chrome.minimise}" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                Click="Maximize_Click" ToolTip="{p:T ui.chrome.maximise}" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                                Click="Close_Click" ToolTip="{p:T ui.chrome.hide}" />
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding Current}" />
            </Grid>
        </Grid>
    </Border>
</Window>
