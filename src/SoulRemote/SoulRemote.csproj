<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows 10 2004 (10.0.19041) rather than a bare net8.0-windows, so the app can
      use the WinRT projections in the Windows SDK. Bluetooth is the reason: turning a
      radio on and off has no Win32 API, only Windows.Devices.Radios, and that is only
      reachable through a version-pinned TFM. The floor this sets - Windows 10 2004,
      released May 2020 - is below what Windows Update still services.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SoulRemote</AssemblyName>
    <RootNamespace>SoulRemote</RootNamespace>
    <!--
      One version, and nothing that overrides it. AssemblyVersion and FileVersion are
      left to the SDK, which derives both from Version - so a release build passing
      -p:Version=x.y.z stamps the number the installer registers into the assembly the
      updater reads back with Assembly.GetName().Version. Pinning them here once meant
      1.0.3 shipped an assembly still calling itself 1.0.2: every copy saw a newer
      release forever, closed itself for an installer that then found 1.0.3 already
      installed and did nothing, and never came back.
    -->
    <Version>1.2.1</Version>
    <Product>Soul Remote</Product>
    <Company>MrSoul</Company>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!--
      Publish settings live here rather than only on the CI command line, so the
      publish command in the README produces the same artefact CI does. Without
      IncludeNativeLibrariesForSelfExtract the "single file" leaves native DLLs
      beside the exe; compression takes the self-contained build from ~162 MB to
      ~72 MB, which matters a great deal to anyone downloading it over a throttled
      connection.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      This is a WPF app that also uses a few WinForms/Drawing types (tray icon, screen
      capture, power status). With ImplicitUsings on, the WinForms SDK injects global
      usings for System.Windows.Forms and System.Drawing, which makes dozens of simple
      names (Application, Binding, Brush, Color, UserControl, LinkState, MessageBox...)
      ambiguous with their WPF equivalents across the whole project. Turning the
      injection off fixes that entire class of error at the root; the handful of files
      that need those namespaces import them explicitly.
    -->
    <EnableWindowsFormsImplicitUsings>false</EnableWindowsFormsImplicitUsings>
    <!-- WinForms + WPF are both enabled; suppress the trim/analyzer noise that is irrelevant to a desktop app. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (ProtectedData) ships as a Microsoft first-party package on .NET; it is not
         part of the shared framework, so it must be referenced explicitly. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- WMI, which is how the panel brightness is read and written. Like DPAPI above,
         it is a first-party package rather than part of the shared framework. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything that does not need Windows: the relay, the bot, settings, strings. -->
    <ProjectReference Include="..\SoulRemote.Core\SoulRemote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      app.ico is both the executable's icon (ApplicationIcon, above) and a WPF
      resource, because the window and the tray load it at run time from
      pack://application:,,,/Assets/app.ico. tools/make-brand.ps1 generates it.
    -->
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
