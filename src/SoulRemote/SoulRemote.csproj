<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SoulRemote</AssemblyName>
    <RootNamespace>SoulRemote</RootNamespace>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <Product>Soul Remote</Product>
    <Company>MrSoul</Company>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!--
      Publish settings live here rather than only on the CI command line, so the
      publish command in the README produces the same artefact CI does. Without
      IncludeNativeLibrariesForSelfExtract the "single file" leaves native DLLs
      beside the exe; compression takes the self-contained build from ~162 MB to
      ~72 MB, which matters a great deal to anyone downloading it over a throttled
      connection.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      This is a WPF app that also uses a few WinForms/Drawing types (tray icon, screen
      capture, power status). With ImplicitUsings on, the WinForms SDK injects global
      usings for System.Windows.Forms and System.Drawing, which makes dozens of simple
      names (Application, Binding, Brush, Color, UserControl, LinkState, MessageBox...)
      ambiguous with their WPF equivalents across the whole project. Turning the
      injection off fixes that entire class of error at the root; the handful of files
      that need those namespaces import them explicitly.
    -->
    <EnableWindowsFormsImplicitUsings>false</EnableWindowsFormsImplicitUsings>
    <!-- WinForms + WPF are both enabled; suppress the trim/analyzer noise that is irrelevant to a desktop app. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (ProtectedData) ships as a Microsoft first-party package on .NET; it is not
         part of the shared framework, so it must be referenced explicitly. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything that does not need Windows: the relay, the bot, settings, strings. -->
    <ProjectReference Include="..\SoulRemote.Core\SoulRemote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      app.ico is both the executable's icon (ApplicationIcon, above) and a WPF
      resource, because the window and the tray load it at run time from
      pack://application:,,,/Assets/app.ico. tools/make-brand.ps1 generates it.
    -->
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
