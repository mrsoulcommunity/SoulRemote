<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SoulRemote</AssemblyName>
    <RootNamespace>SoulRemote</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>Soul Remote</Product>
    <Company>MrSoul</Company>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!--
      This is a WPF app that also uses a few WinForms/Drawing types (tray icon, screen
      capture, power status). With ImplicitUsings on, the WinForms SDK injects global
      usings for System.Windows.Forms and System.Drawing, which makes dozens of simple
      names (Application, Binding, Brush, Color, UserControl, LinkState, MessageBox...)
      ambiguous with their WPF equivalents across the whole project. Turning the
      injection off fixes that entire class of error at the root; the handful of files
      that need those namespaces import them explicitly.
    -->
    <EnableWindowsFormsImplicitUsings>false</EnableWindowsFormsImplicitUsings>
    <!-- WinForms + WPF are both enabled; suppress the trim/analyzer noise that is irrelevant to a desktop app. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (ProtectedData) ships as a Microsoft first-party package on .NET; it is not
         part of the shared framework, so it must be referenced explicitly. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\worker.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- app.ico is optional; only reference it as a resource when present so the build never breaks without it. -->
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>

</Project>
