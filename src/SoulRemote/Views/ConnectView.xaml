<UserControl x:Class="SoulRemote.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulRemote.ViewModels"
             xmlns:p="clr-namespace:SoulRemote.Platform">

    <UserControl.Resources>
        <vm:StepStatusToBrushConverter x:Key="StepBrush" />
        <vm:StepStatusToGlyphConverter x:Key="StepGlyph" />
        <vm:LinkStateToBrushConverter x:Key="StateBrush" />
        <vm:TextToVisibilityConverter x:Key="HasText" />
        <vm:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,10,32,32">
        <StackPanel MaxWidth="900">

            <TextBlock Text="{p:T ui.connect.title}" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource BodyDim}" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                       Text="{p:T ui.connect.intro}" />

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- ===== Inputs ===== -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{p:T ui.connect.cf}" Style="{StaticResource Eyebrow}"
                                           Foreground="{StaticResource RelayBrush}" />
                                <TextBlock Text="{p:T ui.connect.cf.role}" Style="{StaticResource DataDim}" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{p:T ui.connect.cf.field}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         p:PasswordBoxBinding.Attach="True"
                                         p:PasswordBoxBinding.Password="{Binding CloudflareToken, Mode=TwoWay}"
                                         IsEnabled="{Binding IsIdle}" />
                            <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                                       Text="{Binding CloudflareHint}" />
                            <Button Style="{StaticResource GhostButton}" Content="{p:T ui.connect.cf.open}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding OpenCloudflareTokensCommand}" />

                            <TextBlock Text="{p:T ui.connect.worker}" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding WorkerName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{p:T ui.connect.tg}" Style="{StaticResource Eyebrow}"
                                           Foreground="{StaticResource SignalBrush}" />
                                <TextBlock Text="{p:T ui.connect.tg.role}" Style="{StaticResource DataDim}" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{p:T ui.connect.tg.field}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         p:PasswordBoxBinding.Attach="True"
                                         p:PasswordBoxBinding.Password="{Binding TelegramToken, Mode=TwoWay}"
                                         IsEnabled="{Binding IsIdle}" />
                            <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                                       Text="{Binding TelegramHint}" />
                            <Button Style="{StaticResource GhostButton}" Content="{p:T ui.connect.tg.open}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding OpenBotFatherCommand}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ===== Live pipeline ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- The action sits with the panel that reports on it, so it is always
                             visible without scrolling. -->
                        <!-- This is a two-field paste-and-go form, so Enter should submit
                             it and Escape should abandon a run in progress. The two
                             buttons swap on IsBusy and WPF only dispatches these
                             gestures to a visible, enabled target, so both can carry
                             their flag at once without fighting. -->
                        <Button Style="{StaticResource PrimaryButton}" Content="{p:T ui.connect.go}"
                                Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch"
                                IsDefault="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.connect.cancel}"
                                Command="{Binding CancelCommand}" HorizontalAlignment="Stretch"
                                IsCancel="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                        <Border Style="{StaticResource CardInset}" Margin="0,14,0,4"
                                Visibility="{Binding Message, Converter={StaticResource HasText}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,10,0"
                                         Fill="{Binding Outcome, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}"
                                           FontSize="12" MaxWidth="250" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{p:T ui.connect.sequence}" Style="{StaticResource Eyebrow}" Margin="0,16,0,0" />
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Status, Converter={StaticResource StepGlyph}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StepBrush}}"
                                                   FontFamily="{StaticResource DataFont}" FontSize="14"
                                                   FontWeight="Bold" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="12" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DataDim}"
                                                       Margin="0,3,0,0" MaxWidth="260"
                                                       Visibility="{Binding Detail, Converter={StaticResource HasText}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource CardInset}" Margin="0,6,0,0"
                                Visibility="{Binding WorkerUrl, Converter={StaticResource HasText}}">
                            <StackPanel>
                                <TextBlock Text="{p:T ui.connect.endpoint}" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding WorkerUrl}" Style="{StaticResource Data}"
                                           Foreground="{StaticResource SignalBrush}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
