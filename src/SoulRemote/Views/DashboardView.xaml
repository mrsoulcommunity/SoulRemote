<UserControl x:Class="SoulRemote.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulRemote.ViewModels"
             xmlns:ctrl="clr-namespace:SoulRemote.Controls">

    <UserControl.Resources>
        <vm:LinkStateToBrushConverter x:Key="StateBrush" />

        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Display}">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,10,32,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- ===== Hero: the relay chain itself ===== -->
            <Border Style="{StaticResource Card}" Padding="28,26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding Overall, Converter={StaticResource StateBrush}}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Title}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subhead}" Style="{StaticResource BodyDim}" Margin="0,6,0,0" />

                    <ctrl:RelayLine Margin="0,30,0,10"
                                    PcState="{Binding PcState}"
                                    EdgeState="{Binding EdgeState}"
                                    TelegramState="{Binding TelegramState}"
                                    PcDetail="{Binding PcDetail}"
                                    EdgeDetail="{Binding EdgeDetail}"
                                    TelegramDetail="{Binding TelegramDetail}"
                                    EdgeLive="{Binding EdgeLive}"
                                    TelegramLive="{Binding TelegramLive}"
                                    AnimationsEnabled="{Binding AnimationsEnabled}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Start relay"
                                Command="{Binding StartCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Stop"
                                Command="{Binding StopCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Send test message"
                                Command="{Binding TestMessageCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Lock this PC"
                                Command="{Binding LockCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Telemetry strip ===== -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CommandCount}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="COMMANDS RUN" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding LastCommand}" Style="{StaticResource DataDim}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{Binding ChatCount}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="PAIRED CHATS" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding ChatList}" Style="{StaticResource DataDim}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Uptime}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="MACHINE UPTIME" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding BotHandle}" Style="{StaticResource DataDim}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Pairing ===== -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="PAIR A CHAT" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0"
                                   Text="Open your bot in Telegram and send this command. The code works once, then a new one is issued." />
                        <Border Style="{StaticResource CardInset}" Margin="0,14,20,0" HorizontalAlignment="Left">
                            <TextBlock FontFamily="{StaticResource DataFont}" FontSize="20">
                                <Run Text="/pair " Foreground="{StaticResource InkFaintBrush}" />
                                <Run Text="{Binding PairingCode, Mode=OneWay}" Foreground="{StaticResource SignalBrush}" FontWeight="Bold" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource GhostButton}" Content="Copy" Command="{Binding CopyCodeCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="New code" Command="{Binding NewCodeCommand}" Margin="0,8,0,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Revoke all" Command="{Binding RevokeAllCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
