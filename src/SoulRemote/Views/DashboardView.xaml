<UserControl x:Class="SoulRemote.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>

            <!-- Status card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Connection status" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                               FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine:" Style="{StaticResource Muted}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MachineName}" Margin="0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bot:" Style="{StaticResource Muted}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BotUsername}" Margin="0,2" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Proxy URL:" Style="{StaticResource Muted}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WorkerUrl}" Margin="0,2" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="▶ Start bot" Command="{Binding StartCommand}" />
                        <Button Content="⏹ Stop bot" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pairing card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Link a Telegram chat" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Open your bot in Telegram and send the code below to authorize that chat:" />
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="14,10" Margin="0,10"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="/pair " FontFamily="Consolas" FontSize="20" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding PairingCode}" FontFamily="Consolas" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Copy code" Command="{Binding CopyPairingCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="New code" Command="{Binding RegeneratePairingCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    <TextBlock Text="Authorized chats" Style="{StaticResource H2}" Margin="0,14,0,4" />
                    <TextBlock Text="{Binding AuthorizedSummary}" Style="{StaticResource Muted}" />
                    <Button Content="Remove all" Command="{Binding ClearAuthorizedCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
