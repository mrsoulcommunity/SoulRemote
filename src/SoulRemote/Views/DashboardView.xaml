<UserControl x:Class="SoulRemote.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulRemote.ViewModels"
             xmlns:ctrl="clr-namespace:SoulRemote.Controls"
             xmlns:p="clr-namespace:SoulRemote.Platform">

    <UserControl.Resources>
        <vm:LinkStateToBrushConverter x:Key="StateBrush" />
        <vm:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Display}">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,10,32,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- ===== Hero: the relay chain itself ===== -->
            <Border Style="{StaticResource Card}" Padding="28,24,28,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding Overall, Converter={StaticResource StateBrush}}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Title}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subhead}" Style="{StaticResource BodyDim}" Margin="0,6,0,0" />

                    <ctrl:RelayLine Margin="0,26,0,6"
                                    PcState="{Binding PcState}"
                                    EdgeState="{Binding EdgeState}"
                                    TelegramState="{Binding TelegramState}"
                                    PcDetail="{Binding PcDetail}"
                                    EdgeDetail="{Binding EdgeDetail}"
                                    TelegramDetail="{Binding TelegramDetail}"
                                    EdgeLive="{Binding EdgeLive}"
                                    TelegramLive="{Binding TelegramLive}"
                                    AnimationsEnabled="{Binding AnimationsEnabled}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{p:T ui.dash.start}"
                                Command="{Binding StartCommand}" Margin="0,0,10,0"
                                Visibility="{Binding IsRelayRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.dash.stop}"
                                Command="{Binding StopCommand}" Margin="0,0,10,0"
                                Visibility="{Binding IsRelayRunning, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.dash.test}"
                                Command="{Binding TestMessageCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.dash.lockpc}"
                                Command="{Binding LockCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Telemetry strip ===== -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CommandCount}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{p:T ui.dash.stat.commands}" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding LastCommand}" Style="{StaticResource DataDim}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{Binding ChatCount}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{p:T ui.dash.stat.chats}" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding ChatList}" Style="{StaticResource DataDim}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Uptime}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{p:T ui.dash.stat.uptime}" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding BootedAt}" Style="{StaticResource DataDim}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Pairing ===== -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{p:T ui.dash.pair.title}" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0"
                                   Text="{p:T ui.dash.pair.help}" />
                        <!-- The command must be copied character for character, so it opts out of
                             the window's flow direction: under RTL, bidi reordering puts the
                             digits before the slash and the user copies something that is not
                             the command. -->
                        <Border Style="{StaticResource CardInset}" Margin="0,14,20,0" HorizontalAlignment="Left"
                                FlowDirection="LeftToRight">
                            <TextBlock FontFamily="{StaticResource DataFont}" FontSize="20">
                                <Run Text="/pair " Foreground="{StaticResource InkFaintBrush}" />
                                <Run Text="{Binding PairingCode, Mode=OneWay}" Foreground="{StaticResource SignalBrush}" FontWeight="Bold" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.dash.copy}" Command="{Binding CopyCodeCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.dash.newcode}" Command="{Binding NewCodeCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Who is paired =====
                 One row per chat, each revocable on its own. A stolen phone should cost
                 you that one device, not every device you have ever paired. -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasPairedChats, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{p:T ui.dash.pairedlist}" Style="{StaticResource Eyebrow}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button Style="{StaticResource DangerButton}" Content="{p:T ui.dash.revokeall}"
                                HorizontalAlignment="Right" Command="{Binding RevokeAllCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PairedChats}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardInset}" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Body}"
                                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding IdText}" Style="{StaticResource DataDim}"
                                                       FlowDirection="LeftToRight" />
                                        </StackPanel>
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding RemoveText}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
