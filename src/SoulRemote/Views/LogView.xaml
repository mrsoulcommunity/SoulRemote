<UserControl x:Class="SoulRemote.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulRemote.ViewModels"
             xmlns:svc="clr-namespace:SoulRemote.Services;assembly=SoulRemote.Core"
             xmlns:p="clr-namespace:SoulRemote.Platform">

    <UserControl.Resources>
        <vm:EqualsConverter x:Key="Equals" />
        <vm:BoolToVisibilityConverter x:Key="BoolToVis" />

    </UserControl.Resources>

    <Grid Margin="32,10,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{p:T ui.logs.title}" Style="{StaticResource Title}" />
            <TextBlock Text="{p:T ui.logs.subtitle}" Style="{StaticResource BodyDim}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <RadioButton Style="{StaticResource FilterChip}" Content="{p:T ui.logs.all}" GroupName="LogFilter"
                             Command="{Binding SetFilterCommand}" CommandParameter="all"
                             IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=all}" />
                <RadioButton Style="{StaticResource FilterChip}" Content="{p:T ui.logs.problems}" GroupName="LogFilter"
                             Command="{Binding SetFilterCommand}" CommandParameter="problems"
                             IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=problems}" />
                <RadioButton Style="{StaticResource FilterChip}" Content="{p:T ui.logs.errors}" GroupName="LogFilter"
                             Command="{Binding SetFilterCommand}" CommandParameter="errors"
                             IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=errors}" />
            </StackPanel>
            <Button Style="{StaticResource GhostButton}" Content="{p:T ui.logs.clear}" HorizontalAlignment="Right"
                    Command="{Binding ClearCommand}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
          <Grid>
            <!-- An empty list with no explanation reads as a broken page. -->
            <TextBlock Text="{p:T ui.logs.empty}" Style="{StaticResource BodyDim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ListBox x:Name="LogList" ItemsSource="{Binding View}"
                     Background="Transparent" BorderThickness="0"
                     FlowDirection="LeftToRight"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverWashBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                       Style="{StaticResource DataDim}" Margin="0,0,14,0" />
                            <Border Grid.Column="1" Margin="0,0,12,0" Width="3" CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource InkFaintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Info}">
                                                <Setter Property="Background" Value="{StaticResource SignalDeepBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Warning}">
                                                <Setter Property="Background" Value="{StaticResource StandbyBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Error}">
                                                <Setter Property="Background" Value="{StaticResource FaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource DataFont}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Debug}">
                                                <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Warning}">
                                                <Setter Property="Foreground" Value="{StaticResource StandbyBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Error}">
                                                <Setter Property="Foreground" Value="{StaticResource FaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
    </Grid>
</UserControl>
