<UserControl x:Class="SoulRemote.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulRemote.ViewModels">

    <UserControl.Resources>
        <vm:TextToVisibilityConverter x:Key="HasText" />

        <Style x:Key="OptionHint" TargetType="TextBlock" BasedOn="{StaticResource BodyDim}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="50,-4,0,10" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,10,32,32">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource Title}" />
            <TextBlock Text="Changes save as you make them." Style="{StaticResource BodyDim}" Margin="0,6,0,0" />

            <!-- ===== Startup ===== -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,12">
                <StackPanel>
                    <TextBlock Text="STARTUP" Style="{StaticResource Eyebrow}" />
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start Soul Remote when I sign in"
                                  IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Style="{StaticResource OptionHint}"
                                   Text="Adds a per-user entry to Windows startup. No admin rights needed." />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start hidden in the tray"
                                  IsChecked="{Binding StartMinimized}" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start the relay automatically"
                                  IsChecked="{Binding AutoStartBot}" />
                        <TextBlock Style="{StaticResource OptionHint}"
                                   Text="Begins listening as soon as the app launches, so the PC is reachable after a reboot." />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Announce in Telegram when the relay comes online"
                                  IsChecked="{Binding NotifyOnStartup}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Permissions ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WHAT THE BOT MAY DO" Style="{StaticResource Eyebrow}"
                               Foreground="{StaticResource StandbyBrush}" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="Power, screenshot, media and process controls are always available to paired chats. These two are off until you turn them on." />
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox Style="{StaticResource RiskToggleSwitch}" Content="Allow shell commands (/cmd)"
                                  IsChecked="{Binding AllowShellCommands}" />
                        <TextBlock Style="{StaticResource OptionHint}"
                                   Text="Runs anything a paired chat sends. Grants full control of this account — leave off unless you need it." />

                        <CheckBox Style="{StaticResource RiskToggleSwitch}" Content="Allow browsing and fetching files"
                                  IsChecked="{Binding AllowFileAccess}" />
                        <TextBlock Style="{StaticResource OptionHint}"
                                   Text="Lets a paired chat list folders and download files from this PC." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Interface & connection ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="INTERFACE" Style="{StaticResource Eyebrow}" />
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Reduce motion"
                                  IsChecked="{Binding ReduceMotion}" />
                        <TextBlock Style="{StaticResource OptionHint}"
                                   Text="Holds the relay line still instead of animating traffic along it." />
                    </StackPanel>

                    <TextBlock Text="Long-poll timeout (seconds)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource FieldBox}" Width="110" HorizontalAlignment="Left"
                             Text="{Binding PollTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="How long each request waits for new commands. Between 5 and 50; 25 suits most connections." />
                </StackPanel>
            </Border>

            <!-- ===== Files ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ON THIS PC" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource DataDim}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="Tokens in this file are encrypted with Windows DPAPI and can only be read by your account on this machine." />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Open settings folder"
                                Command="{Binding OpenSettingsFileCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Open logs folder"
                                Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SavedAt}" Style="{StaticResource DataDim}" Margin="0,12,0,0"
                               Foreground="{StaticResource SignalBrush}"
                               Visibility="{Binding SavedAt, Converter={StaticResource HasText}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
