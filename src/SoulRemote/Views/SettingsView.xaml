<UserControl x:Class="SoulRemote.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>

            <!-- Cloudflare -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="1 · Cloudflare (the bridge)" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Paste an API token with the 'Edit Cloudflare Workers' permission. Soul Remote deploys a small proxy worker that relays Telegram traffic through Cloudflare's edge." />

                    <TextBlock Text="Cloudflare API token" Margin="0,10,0,0" />
                    <TextBox Text="{Binding CloudflareApiToken, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Worker name" Margin="0,6,0,0" />
                    <TextBox Text="{Binding WorkerName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Proxy secret (auto-generated on connect)" Margin="0,6,0,0" />
                    <TextBox Text="{Binding ProxySecret, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Connect &amp; deploy worker" Command="{Binding ConnectCloudflareCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CloudflareStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding WorkerUrl}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Telegram -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="2 · Telegram bot" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Create a bot with @BotFather, then paste its token here. Traffic is sent only through the Cloudflare worker above." />

                    <TextBlock Text="Bot token" Margin="0,10,0,0" />
                    <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Test connection" Command="{Binding TestTelegramCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TelegramStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="3 · Options" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <CheckBox Content="Start Soul Remote with Windows" IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" />
                    <CheckBox Content="Start the bot automatically on launch" IsChecked="{Binding AutoStartBot}" />
                    <CheckBox Content="Notify authorized chats when the bot comes online" IsChecked="{Binding NotifyOnStartup}" />
                    <CheckBox Content="Allow shell commands via /cmd (advanced — use with care)" IsChecked="{Binding AllowShellCommands}" />

                    <TextBlock Text="Long-poll timeout (seconds)" Margin="0,8,0,0" />
                    <TextBox Text="{Binding PollTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="💾 Save settings" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
