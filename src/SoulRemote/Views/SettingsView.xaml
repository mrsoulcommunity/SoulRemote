<UserControl x:Class="SoulRemote.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulRemote.ViewModels"
             xmlns:p="clr-namespace:SoulRemote.Platform">

    <UserControl.Resources>
        <vm:TextToVisibilityConverter x:Key="HasText" />
        <vm:BoolToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="OptionHint" TargetType="TextBlock" BasedOn="{StaticResource BodyDim}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="50,-4,0,10" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,10,32,32">
        <!-- Stretch, not Left: MaxWidth then centres the column, which is what the
             dashboard, connect and activity pages all do. Pinned left it was the one
             page that slid to the edge of a maximised window. -->
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">

            <TextBlock Text="{p:T ui.settings.title}" Style="{StaticResource Title}" />
            <TextBlock Text="{p:T ui.settings.autosave}" Style="{StaticResource BodyDim}" Margin="0,6,0,0" />

            <!-- ===== Language =====
                 First on the page on purpose: someone who cannot read the rest of this
                 screen needs to find this control without reading anything else, so it
                 sits where the eye lands and both options are written in their own
                 language rather than translated into the other one. -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,12">
                <StackPanel>
                    <TextBlock Text="{p:T ui.settings.language}" Style="{StaticResource Eyebrow}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="Language"
                                     Content="{p:T ui.settings.english}"
                                     Command="{Binding SetLanguageCommand}" CommandParameter="en"
                                     IsChecked="{Binding IsEnglish, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="Language"
                                     Content="{p:T ui.settings.persian}"
                                     Command="{Binding SetLanguageCommand}" CommandParameter="fa"
                                     IsChecked="{Binding IsPersian, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OptionHint}" Margin="0,10,0,0"
                               Text="{p:T ui.settings.language.hint}" />
                </StackPanel>
            </Border>

            <!-- ===== Startup ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{p:T ui.settings.startup}" Style="{StaticResource Eyebrow}" />
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{p:T ui.settings.startwin}"
                                  IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.startwin.hint}" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{p:T ui.settings.startmin}"
                                  IsChecked="{Binding StartMinimized}" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{p:T ui.settings.autostart}"
                                  IsChecked="{Binding AutoStartBot}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.autostart.hint}" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{p:T ui.settings.notify}"
                                  IsChecked="{Binding NotifyOnStartup}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Permissions ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{p:T ui.settings.permissions}" Style="{StaticResource Eyebrow}"
                               Foreground="{StaticResource StandbyBrush}" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="{p:T ui.settings.permissions.hint}" />
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox Style="{StaticResource RiskToggleSwitch}" Content="{p:T ui.settings.shell.label}"
                                  IsChecked="{Binding AllowShellCommands}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.shell.hint}" />

                        <CheckBox Style="{StaticResource RiskToggleSwitch}" Content="{p:T ui.settings.files.label}"
                                  IsChecked="{Binding AllowFileAccess}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.files.hint}" />

                        <CheckBox Style="{StaticResource RiskToggleSwitch}" Content="{p:T ui.settings.typing.label}"
                                  IsChecked="{Binding AllowInputInjection}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.typing.hint}" />
                    </StackPanel>

                    <TextBlock Text="{p:T ui.settings.downloads}" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding DownloadFolder, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding AllowFileAccess}" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="{p:T ui.settings.downloads.hint}" />
                </StackPanel>
            </Border>

            <!-- ===== Interface & connection ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{p:T ui.settings.interface}" Style="{StaticResource Eyebrow}" />
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{p:T ui.settings.reducemotion}"
                                  IsChecked="{Binding ReduceMotion}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.reducemotion.hint}" />
                    </StackPanel>

                    <TextBlock Text="{p:T ui.settings.polltimeout}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource FieldBox}" Width="110" HorizontalAlignment="Left"
                             Text="{Binding PollTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="{p:T ui.settings.polltimeout.hint}" />

                    <TextBlock Text="{p:T ui.settings.logretention}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource FieldBox}" Width="110" HorizontalAlignment="Left"
                             Text="{Binding LogRetentionDays, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="{p:T ui.settings.logretention.hint}" />
                </StackPanel>
            </Border>

            <!-- ===== Updates =====
                 The same view model the shell shows as a card. Here it is the quiet
                 version: what version is running, one button to look now, and the two
                 switches that decide whether it ever looks or installs on its own. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{p:T ui.settings.updates}" Style="{StaticResource Eyebrow}" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="{Binding Update.Status}"
                                   VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Update.HasFault}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource FaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.settings.update.check}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding Update.CheckCommand}" />
                    </Grid>

                    <ProgressBar Style="{StaticResource ConduitProgress}" Margin="0,14,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Update.Percent, Mode=OneWay}"
                                 IsIndeterminate="{Binding Update.ProgressIsIndeterminate}"
                                 Visibility="{Binding Update.ShowProgress, Converter={StaticResource BoolVis}}" />

                    <StackPanel Margin="0,18,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{p:T ui.settings.update.auto}"
                                  IsChecked="{Binding Update.AutoCheck}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.update.auto.hint}" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{p:T ui.settings.update.autoinstall}"
                                  IsChecked="{Binding Update.AutoInstall}" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{p:T ui.settings.update.autoinstall.hint}" />
                    </StackPanel>

                    <TextBlock Text="{p:T ui.update.portable}" Style="{StaticResource BodyDim}" FontSize="12"
                               Margin="0,4,0,0"
                               Visibility="{Binding Update.IsPortableCopy, Converter={StaticResource BoolVis}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{p:T ui.settings.update.install}"
                                Command="{Binding Update.UpdateNowCommand}" Margin="0,0,10,0"
                                Visibility="{Binding Update.CanUpdateNow, Converter={StaticResource BoolVis}}" />
                        <Button Style="{StaticResource LinkButton}" Content="{p:T ui.settings.update.notes}"
                                Command="{Binding Update.OpenReleaseCommand}"
                                Visibility="{Binding Update.HasReleasePage, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Files ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{p:T ui.settings.onthispc}" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource DataDim}" Margin="0,10,0,0"
                               TextWrapping="Wrap" FlowDirection="LeftToRight" />
                    <TextBlock Style="{StaticResource BodyDim}" Margin="0,8,0,0" FontSize="12"
                               Text="{p:T ui.settings.dpapi}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.settings.opensettings}"
                                Command="{Binding OpenSettingsFileCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{p:T ui.settings.openlogs}"
                                Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SavedAt}" Style="{StaticResource DataDim}" Margin="0,12,0,0"
                               Foreground="{StaticResource SignalBrush}"
                               Visibility="{Binding SavedAt, Converter={StaticResource HasText}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
