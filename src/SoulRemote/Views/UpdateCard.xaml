<UserControl x:Class="SoulRemote.Views.UpdateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulRemote.ViewModels"
             xmlns:p="clr-namespace:SoulRemote.Platform"
             Focusable="True"
             IsVisibleChanged="Card_IsVisibleChanged">

    <!--
        The one moment the app interrupts the user. It gets a single card, one primary
        action, and no second decision to make: what is new, how big it is, and a button
        that downloads it, verifies it, installs it and brings the app back.
    -->
    <UserControl.Resources>
        <vm:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding LaterCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource Card}" Width="620" Padding="30,28"
            CornerRadius="14" VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="{StaticResource DeckRaisedBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="10" Direction="270"
                              Color="#FF000000" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>

            <!-- Eyebrow: relay colour, because an update arrives over the same link. -->
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource RelayBrush}" />
                <TextBlock Text="{p:T ui.update.eyebrow}" Style="{StaticResource Eyebrow}"
                           Margin="9,0,0,0" Foreground="{StaticResource RelayBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding Headline}" Style="{StaticResource Display}" Margin="0,14,0,0" />
            <TextBlock Text="{Binding Meta}" Style="{StaticResource DataDim}" Margin="0,8,0,0"
                       FlowDirection="LeftToRight" HorizontalAlignment="Left" />

            <!-- What changed, as published on the release. -->
            <Border Style="{StaticResource CardInset}" Margin="0,20,0,0"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Body}"
                               Foreground="{StaticResource InkDimBrush}" LineHeight="20" />
                </ScrollViewer>
            </Border>

            <!-- Progress, only while something is actually moving. -->
            <ProgressBar Style="{StaticResource ConduitProgress}" Margin="0,22,0,0"
                         Minimum="0" Maximum="100"
                         Value="{Binding Percent, Mode=OneWay}"
                         IsIndeterminate="{Binding ProgressIsIndeterminate}"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}" />

            <TextBlock Text="{Binding Status}" Margin="0,14,0,0"
                       Visibility="{Binding ShowStatus, Converter={StaticResource BoolVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                        <Setter Property="Foreground" Value="{StaticResource InkDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFault}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource FaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- A copy the installer did not put here cannot replace itself. -->
            <TextBlock Text="{p:T ui.update.portable}" Style="{StaticResource BodyDim}"
                       FontSize="12" Margin="0,10,0,0"
                       Visibility="{Binding IsPortableCopy, Converter={StaticResource BoolVis}}" />

            <Grid Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource PrimaryButton}" Content="{p:T ui.settings.update.install}"
                            Command="{Binding UpdateNowCommand}" MinWidth="150"
                            Visibility="{Binding IsPortableCopy, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                    <Button Style="{StaticResource GhostButton}" Content="{p:T ui.update.later}"
                            Command="{Binding LaterCommand}" Margin="10,0,0,0" MinWidth="110" />
                </StackPanel>

                <Button Style="{StaticResource LinkButton}" Content="{p:T ui.settings.update.notes}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding OpenReleaseCommand}"
                        Visibility="{Binding HasReleasePage, Converter={StaticResource BoolVis}}" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
